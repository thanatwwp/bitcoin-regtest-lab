# The dashboard only binds to 127.0.0.1. Keep real credentials in .env,
# which is ignored by Git, and never place them in frontend files.
DASHBOARD_PORT=3000
# Set false to disable all actions and return to a read-only dashboard.
DASHBOARD_ACTIONS_ENABLED=true
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443
# Leave both empty to use an existing bitcoin.conf via BITCOIN_CONFIG_PATH,
# or set both privately in .env. Never commit the real values.
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# The WSL launcher locates the file automatically. For direct Windows startup,
# replace YOUR_LINUX_USER with the username inside your distribution.
# BITCOIN_CONFIG_PATH=\\wsl.localhost\Ubuntu\home\YOUR_LINUX_USER\.bitcoin\bitcoin.conf
ELECTRS_HOST=127.0.0.1
ELECTRS_PORT=60401
REQUEST_TIMEOUT_MS=4000
AUTO_REFRESH_MS=10000
